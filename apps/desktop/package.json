{
  "name": "@deepseek-ai/dsh-desktop",
  "productName": "DeepSeek Harness Desktop",
  "description": "Windows portable Electron shell hosting the dsh --profile web backend",
  "version": "0.1.3-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "apps/desktop"
  },
  "type": "module",
  "main": "lib/main.js",
  "files": [
    "lib/**/*"
  ],
  "scripts": {
    "build": "tsc -b && node scripts/copy-preload.mjs",
    "start": "electron .",
    "assemble": "node scripts/assemble.mjs",
    "dist": "pnpm install && electron-builder --config electron-builder.yml --publish never"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "44.2.0",
    "electron-builder": "26.15.3",
    "typescript": "^6.0.3"
  }
}
